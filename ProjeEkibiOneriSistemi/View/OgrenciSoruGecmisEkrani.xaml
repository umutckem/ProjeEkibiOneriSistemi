<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.OgrenciSoruGecmisEkrani"
             Loaded="ContentPage_Loaded"
             >

    <Grid>
        <Image Source="ogrenciekrani.jpg" Aspect="AspectFill" HeightRequest="1200"/>
        <CollectionView x:Name="CollectionViewSoruGecmisi" HeightRequest="500" SelectionMode="Single" SelectionChanged="CollectionViewSoruGecmisi_SelectionChanged">
    <CollectionView.ItemTemplate>
        <DataTemplate>
            <VerticalStackLayout  HorizontalOptions="Start" Padding="50,10" Spacing="0">
                
                <HorizontalStackLayout>
                    <Label Text="Id:" Padding="10,0" TextColor="GreenYellow"  FontFamily="Cambria"/>
                    <Label Text="{Binding Id}" TextColor="White"  FontFamily="Cambria"/>
                </HorizontalStackLayout>
                
                <HorizontalStackLayout>
                    <Label Text="Ogrenci Id:" Padding="10,0" TextColor="GreenYellow"  FontFamily="Cambria" FontSize="16"/>
                    <Label Text="{Binding OgrenciId}" TextColor="White"  FontFamily="Cambria" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Kategori Id:" Padding="10,0" TextColor="GreenYellow"  FontFamily="Cambria" FontSize="16"/>
                    <Label Text="{Binding KategoriId}" TextColor="White"  FontFamily="Cambria" FontSize="16"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout>
                    <Label Text="Soru Id:" Padding="10,0" TextColor="GreenYellow"  FontFamily="Cambria" FontSize="16"/>
                    <Label Text="{Binding SoruId}" TextColor="White"  FontFamily="Cambria" FontSize="16"/>
                </HorizontalStackLayout>

                    </VerticalStackLayout>
        </DataTemplate>
    </CollectionView.ItemTemplate>
</CollectionView>


    </Grid>

</ContentPage>