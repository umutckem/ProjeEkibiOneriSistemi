<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.SifreDegistirmeEkrani">
    <Grid>
        <Image Source="profilekrani.jpg" HeightRequest="1000"/>
        <Frame WidthRequest="600" HeightRequest="400" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,100" BackgroundColor="#2C3E50" Opacity="0.5"/>
        <Entry x:Name="sifre" VerticalOptions="Start" HorizontalOptions="Center" WidthRequest="200" Margin="0,200" Placeholder="Sifre" IsPassword="True"/>
        <Entry x:Name="tekrarSifre" VerticalOptions="Start" HorizontalOptions="Center" WidthRequest="200" Margin="0,250" Placeholder="Tekar Sifre" IsPassword="True"/>
        <Button VerticalOptions="Start" HorizontalOptions="Center" WidthRequest="200" Text="Tamam" FontAttributes="Italic" FontFamily="Arial" Margin="0,300" Clicked="Button_Clicked"/>
    </Grid>

</ContentPage>