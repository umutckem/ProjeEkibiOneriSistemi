<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminOgrenciDuzenlemeEkrani"
             Loaded="ContentPage_Loaded">
    <Grid>
        
        <Image Source="adminekrani.png" Aspect="AspectFill" Opacity="0.3" HeightRequest="999"/>

        <Frame Margin="20"
              CornerRadius="20"
              BackgroundColor="{AppThemeBinding Light=#f5f5f5, Dark=#333333}"
              BorderColor="{AppThemeBinding Light=#e0e0e0, Dark=#444444}"
              Padding="0">

            <ScrollView>
                <StackLayout Spacing="15" Padding="20">

                    <StackLayout HorizontalOptions="Center" Spacing="10">
                        <Image Source="profile_icon.png" 
                              HeightRequest="80" 
                              WidthRequest="80"
                              Aspect="AspectFill"
                              HorizontalOptions="Center">
                            <Image.Clip>
                                <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40"/>
                            </Image.Clip>
                        </Image>
                        <Label Text="Öğrenci Bilgileri" 
                              FontSize="24" 
                              FontAttributes="Bold"
                              HorizontalOptions="Center"/>
                    </StackLayout>

                    <Frame BackgroundColor="{AppThemeBinding Light=#ffffff, Dark=#424242}"
                          CornerRadius="12"
                          Padding="15"
                          HasShadow="True">
                        <VerticalStackLayout Spacing="12">

                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="ID:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Id}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Ad:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Ad}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Soyad:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Soyad}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Ogrenci No:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding ogrenciNo}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Bolum:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Bolum}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Sinif:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Sinif}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="ToplamCVPSRSayisi:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding ToplamCevaplananSoruSayisi}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="ORT Puan:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding OrtalamaPuan}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="Email:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding Email}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="BabaAdi:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding BabaAdi}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="AnneAdi:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding AnneAdi}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" 
                                    Color="{AppThemeBinding Light=#eeeeee, Dark=#555555}"/>
                            <HorizontalStackLayout Spacing="5">
                                <Label Text="" 
                                      FontFamily="FontAwesome"
                                      FontSize="18"
                                      VerticalOptions="Center"/>
                                <Label Text="TC:" 
                                      FontSize="18"
                                      VerticalOptions="Center"
                                      WidthRequest="120"/>
                                <Label Text="{Binding TC}" 
                                      FontSize="18"
                                      FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                            
                        </VerticalStackLayout>
                    </Frame>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15">
                        <Button Text="Düzenle" 
                               CornerRadius="10"
                               BackgroundColor="#4CAF50"
                               TextColor="White"
                               FontAttributes="Bold"
                               HeightRequest="45"
                               Clicked="Button_Clicked_2"/>
                        <Button Text="Sil" 
                               CornerRadius="10"
                               BackgroundColor="#F44336"
                               TextColor="White"
                               FontAttributes="Bold"
                               Grid.Column="1"
                               HeightRequest="45"
                               Clicked="Button_Clicked_1"/>
                        <Button Text="Geri" 
                               CornerRadius="10"
                               BackgroundColor="AntiqueWhite"
                               TextColor="Black"
                               FontAttributes="Bold"
                               Grid.Column="2"
                               HeightRequest="45"
                               Clicked="Button_Clicked"/>
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Frame>
    </Grid>
</ContentPage>