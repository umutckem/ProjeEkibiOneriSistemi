<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminProjeDuzenleme"
             BackgroundColor="#121212"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Arka Plan Görseli -->
        <Image Source="adminekrani.png"
               Aspect="AspectFill"
               Opacity="0.2"
               IsVisible="True"
               Grid.RowSpan="3"/>

        <!-- Arama Alanı -->
        <Frame Grid.Row="0"
               Margin="10"
               Padding="0"
               CornerRadius="20"
               HasShadow="True"
               BackgroundColor="#1E1E1E">
            <StackLayout Padding="20">
                <SearchBar x:Name="SearchBarProje" 
                           Placeholder="Proje ara..." 
                           BackgroundColor="#2C2C2C" 
                           TextColor="White"
                           PlaceholderColor="DarkGray"
                           CancelButtonColor="Gray"
                           FontAttributes="Bold"
                           TextChanged="SearchBarProje_TextChanged"/>
            </StackLayout>
        </Frame>

        <!-- Proje Listesi -->
        <ScrollView Grid.Row="1" Padding="10">
            <CollectionView x:Name="CollectionViewProje"
                            SelectionMode="Single"
                            SelectionChanged="CollectionViewProje_SelectionChanged"
                            BackgroundColor="Transparent">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#03DAC6" CornerRadius="15" Padding="15" Margin="10" BackgroundColor="#1E1E1E">
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="10" ColumnSpacing="10">

                                <Label Text="Ad:" TextColor="#03DAC6" FontSize="16" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding Ad}" TextColor="White" FontSize="16" Grid.Row="0" Grid.Column="1"/>

                                <Label Text="Açıklama:" TextColor="#03DAC6" FontSize="16" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding Aciklama}" TextColor="White" FontSize="16" Grid.Row="1" Grid.Column="1"/>

                                <Label Text="Bölüm:" TextColor="#03DAC6" FontSize="16" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding Bolum}" TextColor="White" FontSize="16" Grid.Row="2" Grid.Column="1"/>

                                <Label Text="Aktif mi:" TextColor="#03DAC6" FontSize="16" Grid.Row="3" Grid.Column="0"/>
                                <Label Text="{Binding AktifMi}" TextColor="White" FontSize="16" Grid.Row="3" Grid.Column="1"/>

                                <Label Text="Başlangıç Tarihi:" TextColor="#03DAC6" FontSize="16" Grid.Row="4" Grid.Column="0"/>
                                <Label Text="{Binding BaslangicTarihi}" TextColor="White" FontSize="16" Grid.Row="4" Grid.Column="1"/>

                                <Label Text="Bitiş Tarihi:" TextColor="#03DAC6" FontSize="16" Grid.Row="5" Grid.Column="0"/>
                                <Label Text="{Binding BitisTarihi}" TextColor="White" FontSize="16" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Alt Panel -->
        <Frame Grid.Row="2"
               CornerRadius="20"
               Margin="10"
               BackgroundColor="#1E1E1E"
               Padding="10">
            <StackLayout Spacing="10">

                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Center"
                             Spacing="20">
                    <Button Text="Ana Menü" 
                            WidthRequest="150"
                            BackgroundColor="#388E3C" 
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Clicked="Button_Clicked"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Start"
                             Padding="10,0,0,0">
                    <Label Text="Kayıtlı Proje Sayısı:" TextColor="White"/>
                    <Label x:Name="ogrenciProje" Text="" TextColor="#FF9800" Margin="10,0,0,0"/>
                </StackLayout>

            </StackLayout>
        </Frame>

    </Grid>

</ContentPage>
