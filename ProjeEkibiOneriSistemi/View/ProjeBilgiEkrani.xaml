<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.ProjeBilgiEkrani"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto,*,Auto">
        
        <Image Source="ogrenciekrani.jpg" Aspect="AspectFill" Opacity="0.35" Grid.RowSpan="3"/>

       
        <Frame Grid.Row="0"
               CornerRadius="0"
               Padding="20"
               Margin="0"
               BackgroundColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
               HasShadow="True">
            <Label Text="{Binding Ad}"
                   FontSize="24"
                   FontFamily="OpenSansBold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Frame>

        
        <ScrollView Grid.Row="1" Padding="20">
            <Frame CornerRadius="20"
                   Padding="20"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                   HasShadow="True">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" 
                      RowSpacing="15"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="15">

                    <Label Text="Açıklama:"
                           Grid.Row="0" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <Label Text="{Binding Aciklama}"
                           Grid.Row="0" Grid.Column="1"
                           TextColor="{AppThemeBinding Light=#212121, Dark=White}"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           LineBreakMode="WordWrap"/>

                    
                    <Label Text="Süre:"
                           Grid.Row="1" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <StackLayout Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="20">
                        <StackLayout Orientation="Vertical" Spacing="5">
                            <Label Text="Başlangıç"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                   FontFamily="OpenSansSemiBold"
                                   FontSize="12"/>
                            <Label Text="{Binding BaslangicTarihi}"
                                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"/>
                        </StackLayout>
                        <StackLayout Orientation="Vertical" Spacing="5">
                            <Label Text="Bitiş"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                   FontFamily="OpenSansSemiBold"
                                   FontSize="12"/>
                            <Label Text="{Binding BitisTarihi}"
                                   TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                                   FontFamily="OpenSansRegular"
                                   FontSize="14"/>
                        </StackLayout>
                    </StackLayout>

                    
                    <Label Text="Durum:"
                           Grid.Row="2" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <Label Text="{Binding AktifMi, Converter={StaticResource BoolToStatusConverter}}"
                           Grid.Row="2" Grid.Column="1"
                           TextColor="{Binding AktifMi, Converter={StaticResource StatusToColorConverter}}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="14"/>

                    
                    <Label Text="Gereksinimler:"
                           Grid.Row="3" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <Label x:Name="ProjeGereksinimleriLabel"
                           Grid.Row="3" Grid.Column="1"
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           LineBreakMode="WordWrap"/>

                    
                    <Label Text="Gerekli Yetkinlikler:"
                           Grid.Row="4" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <Label x:Name="OgrenciYetkinlikleriLabel"
                           Grid.Row="4" Grid.Column="1"
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           FontFamily="OpenSansRegular"
                           FontSize="14"
                           LineBreakMode="WordWrap"/>

                    
                    <Label Text="Eşleşme Oranı:"
                           Grid.Row="5" Grid.Column="0"
                           TextColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="16"/>
                    <ProgressBar Progress="{Binding EslesmeOrani}"
                                 Grid.Row="5" Grid.Column="1"
                                 ProgressColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                                 VerticalOptions="Center"/>
                    <Label Text="{Binding EslesmeOrani, StringFormat='{0:P0}'}"
                           Grid.Row="5" Grid.Column="1"
                           HorizontalOptions="End"
                           TextColor="{AppThemeBinding Light=#424242, Dark=#E0E0E0}"
                           FontFamily="OpenSansSemiBold"
                           FontSize="14"/>
                </Grid>
            </Frame>
        </ScrollView>

        
        <Button x:Name="KatilimButton"
                Grid.Row="2"
                Text="PROJEYE KATIL"
                CornerRadius="25"
                Margin="20"
                HeightRequest="50"
                FontSize="16"
                FontFamily="OpenSansBold"
                BackgroundColor="{AppThemeBinding Light=#6200EE, Dark=#BB86FC}"
                TextColor="White"
                IsEnabled="{Binding KatilimIzinli}"
                Clicked="Button_Clicked"/>
    </Grid>
</ContentPage>