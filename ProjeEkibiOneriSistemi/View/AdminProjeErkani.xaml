<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminProjeErkani"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Arka Plan Görseli -->
        <Image Source="adminekrani.png"
               Aspect="AspectFill"
               Opacity="0.3"
               IsVisible="True"
               Grid.RowSpan="3"/>

        <!-- Üst Sabit Arama Alanı -->
        <StackLayout Grid.Row="0"
                     Padding="20"
                     BackgroundColor="#FFFFFFCC"
                     >

            <SearchBar x:Name="SearchBarProje" 
                       Placeholder="Öğrenci ara..." 
                       TextChanged="SearchBarProje_TextChanged"
                       BackgroundColor="White" 
                       TextColor="Black"
                       PlaceholderColor="Gray"/>
        </StackLayout>

        <!-- Orta Kaydırılabilir Liste -->
        <ScrollView Grid.Row="1" Padding="10">
            <CollectionView x:Name="CollectionViewProje"
                            SelectionMode="Single"
                            SelectionChanged="CollectionViewProje_SelectionChanged"
                            BackgroundColor="Transparent">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="GreenYellow" CornerRadius="10" Padding="15" Margin="10" BackgroundColor="Black">
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="10" ColumnSpacing="10">

                                <Label Text="Ad:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding Ad}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="0" Grid.Column="1"/>

                                <Label Text="Açıklama:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding Aciklama}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="1" Grid.Column="1"/>

                                <Label Text="Bölüm:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding Bolum}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="2" Grid.Column="1"/>

                                <Label Text="Aktif mi:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="3" Grid.Column="0"/>
                                <Label Text="{Binding AktifMi}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="3" Grid.Column="1"/>

                                <Label Text="Başlangıç Tarihi:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="4" Grid.Column="0"/>
                                <Label Text="{Binding BaslangicTarihi}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="4" Grid.Column="1"/>

                                <Label Text="Bitiş Tarihi:" TextColor="GreenYellow" FontFamily="Cambria" FontSize="16" Grid.Row="5" Grid.Column="0"/>
                                <Label Text="{Binding BitisTarihi}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Alt Sabit Butonlar ve Sayı -->
        <StackLayout Grid.Row="2"
                     Padding="10"
                     BackgroundColor="#FFFFFFCC"
                     Orientation="Vertical"
                     Spacing="5">

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Center"
                         Spacing="20">
                <Button Text="Ana Menü" 
                        WidthRequest="150"
                        BackgroundColor="Green" 
                        FontAttributes="Bold" 
                        Clicked="Button_Clicked"/>

                <Button Text="Proje Ekle" 
                        WidthRequest="150"
                        BackgroundColor="Yellow" 
                        FontAttributes="Bold" 
                        Clicked="Button_Clicked_1"/>
            </StackLayout>

            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Start"
                         Padding="10,0,0,0">
                <Label Text="Kayıtlı Proje Sayısı:" TextColor="Black"/>
                <Label x:Name="ogrenciProje" Text="" TextColor="Black" Margin="10,0,0,0"/>
            </StackLayout>

        </StackLayout>

    </Grid>
</ContentPage>
