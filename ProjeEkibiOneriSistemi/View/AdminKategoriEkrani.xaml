<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminKategoriEkrani"
             BackgroundColor="#181818"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">

        <Image Source="adminekrani.png"
               Aspect="AspectFill"
               Opacity="0.1"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               Grid.RowSpan="3"/>

        <Frame Grid.Row="0" Padding="20" Margin="10" CornerRadius="25" BackgroundColor="#252525" HasShadow="True">
            <SearchBar x:Name="SearchBarTest" 
                       Placeholder="kategori ara..." 
                       BackgroundColor="#333333"
                       TextColor="White"
                       PlaceholderColor="#BBBBBB"
                       HeightRequest="50"
                       TextChanged="SearchBarTest_TextChanged"/>
        </Frame>

        <ScrollView Grid.Row="1" Padding="20">
            <CollectionView x:Name="CollectionViewTestler"
                            SelectionMode="Single"
                            SelectionChanged="CollectionViewTestler_SelectionChanged"
                            BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#26A69A" CornerRadius="15" Padding="20" Margin="10" BackgroundColor="#222222" HasShadow="True">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="Auto,*" RowSpacing="15" ColumnSpacing="15">

                                <Label Text="Id:" TextColor="#26A69A" FontSize="16" FontAttributes="Bold" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding Id}" TextColor="White" FontSize="16" Grid.Row="0" Grid.Column="1"/>

                                <Label Text="Kategori:" TextColor="#26A69A" FontSize="16" FontAttributes="Bold" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding KategoriAdi}" TextColor="White" FontSize="16" Grid.Row="1" Grid.Column="1"/>

                                <Label Text="İlgili Bölüm:" TextColor="#26A69A" FontSize="16" FontAttributes="Bold" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding IlgiliBolum}" TextColor="White" FontSize="16" Grid.Row="2" Grid.Column="1"/>

                                <Label Text="Soru Sayısı:" TextColor="#26A69A" FontSize="16" FontAttributes="Bold" Grid.Row="3" Grid.Column="0"/>
                                <Label Text="{Binding SoruSayisi}" TextColor="White" FontSize="16" Grid.Row="3" Grid.Column="1"/>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Frame Grid.Row="2" Padding="20" Margin="10" CornerRadius="25" BackgroundColor="#252525" HasShadow="True">
            <StackLayout Spacing="15">
                <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Spacing="25">
                    <Button Text="Ana Menü"
                            WidthRequest="160"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            CornerRadius="15"
                            HeightRequest="50"
                            Clicked="Button_Clicked">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Opacity="0.3" Radius="5" Offset="2,2"/>
                        </Button.Shadow>
                    </Button>

                    <Button Text="Kategori Ekle"
                            WidthRequest="160"
                            BackgroundColor="#007aff"
                            TextColor="White"
                            CornerRadius="15"
                            HeightRequest="50"
                            Clicked="Button_TestEkle_Clicked">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Opacity="0.3" Radius="5" Offset="2,2"/>
                        </Button.Shadow>
                    </Button>
                </StackLayout>

                <StackLayout Orientation="Horizontal" HorizontalOptions="Start" Spacing="10">
                    <Label Text="Toplam Test Sayısı:" TextColor="White" FontSize="14"/>
                    <Label x:Name="testSayisi" Text="" TextColor="#FFD700" FontSize="14" FontAttributes="Bold"/>
                </StackLayout>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>
