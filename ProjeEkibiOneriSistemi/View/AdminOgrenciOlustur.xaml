<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminOgrenciOlustur"
             BackgroundColor="White">

    <ScrollView>
        <Grid>
            <Image Source="adminekrani.png"
                   Aspect="AspectFill"
                   Opacity="0.05"
                   IsVisible="True"
                   VerticalOptions="Fill"
                   HorizontalOptions="Fill"
                   Grid.RowSpan="1" />

            <StackLayout Padding="20" Spacing="15" VerticalOptions="Center">

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Ad:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciAd" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Soyad:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciSoyad" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Baba Adı:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciBabaAdi" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Anne Adı:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciAnneAdi" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="E-mail:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciEmail" Keyboard="Email" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Telefon:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciTelefon" Keyboard="Telephone" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Bölüm:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciBolum" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Sınıf:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciSinif" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Öğrenci No:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciogrenciNo" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="TC Kimlik No:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciTC" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="10">
                    <Label Text="Resim Yolu:" WidthRequest="120" VerticalTextAlignment="Center" TextColor="#333333"/>
                    <Entry x:Name="ogrenciogrenciResmi" TextColor="#222222" BackgroundColor="#f0f0f0"/>
                </StackLayout>

                <Button Text="Öğrenci Oluştur"
                        BackgroundColor="#007aff"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45" 
                        Clicked="Button_Clicked_1"/>

                <Button Text="Ana Menü"
                        BackgroundColor="#fdf6e3"
                        TextColor="Black"
                        CornerRadius="10"
                        HeightRequest="45"
                        Clicked="Button_Clicked" />
            </StackLayout>
        </Grid>
    </ScrollView>

</ContentPage>
