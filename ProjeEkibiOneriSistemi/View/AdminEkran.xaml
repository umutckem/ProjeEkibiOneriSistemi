<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminEkran"
             Loaded="ContentPage_Loaded"
             Title="Admin Paneli">

    <Grid ColumnDefinitions="220,*" RowDefinitions="80,*">

        
        <Frame Grid.Column="0" Grid.RowSpan="2" BackgroundColor="#2E4053" CornerRadius="0" HasShadow="True">
            <StackLayout Spacing="15" Padding="10,40,10,20">
                
                <Frame CornerRadius="100" HeightRequest="100" WidthRequest="100" 
                       HorizontalOptions="Center" Padding="0" HasShadow="True">
                    <Image Source="{Binding ogrenciResmi}" Aspect="AspectFill" 
                           HeightRequest="100" WidthRequest="100"/>
                </Frame>

                <Label Text="Admin Paneli" FontSize="18" TextColor="White" 
                       HorizontalOptions="Center" FontAttributes="Bold"/>

                <Label Text="{Binding Bolum}" FontSize="14" TextColor="#AED6F1" 
                       HorizontalOptions="Center" FontAttributes="Italic"/>

                <BoxView HeightRequest="1" Color="#566573" Margin="0,10"/>

                
                <Button Text="Öğrenciler" Clicked="Button_Clicked" 
                        BackgroundColor="#3498DB" TextColor="White" 
                        CornerRadius="10" FontAttributes="Bold" HeightRequest="45"/>

                <Button Text="Projeler" Clicked="Button_Clicked_1" 
                        BackgroundColor="#3498DB" TextColor="White" 
                        CornerRadius="10" FontAttributes="Bold" HeightRequest="45"/>

                <Button Text="Testler" Clicked="Button_Clicked_2" 
                        BackgroundColor="#3498DB" TextColor="White" 
                        CornerRadius="10" FontAttributes="Bold" HeightRequest="45"/>

                <Button Text="Destek" 
                        BackgroundColor="#3498DB" TextColor="White" 
                        CornerRadius="10" FontAttributes="Bold" HeightRequest="45"/>

                <BoxView HeightRequest="1" Color="#566573" Margin="0,10"/>

                <Button x:Name="Cikis" Text="Çıkış Yap" Clicked="Cikis_Clicked" 
                        BackgroundColor="#E74C3C" TextColor="White" 
                        CornerRadius="10" FontAttributes="Bold" HeightRequest="45"/>
            </StackLayout>
        </Frame>

       
        <Frame Grid.Column="1" Grid.Row="0" BackgroundColor="#F8F9F9" 
               CornerRadius="0" HasShadow="False" Padding="20">
            <Label Text="Yönetim Paneli" FontSize="24" FontAttributes="Bold" 
                   TextColor="#2C3E50" VerticalOptions="Center"/>
        </Frame>

        <Grid Grid.Column="1" Grid.Row="1" Padding="20" ColumnDefinitions="*,*,*" RowDefinitions="*,*" 
              RowSpacing="20" ColumnSpacing="20">

            
            <Frame Grid.Column="0" Grid.Row="0" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Öğrenci Sayısı" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label x:Name="KayitliOgrenciSayisi" FontSize="28" TextColor="#2C3E50" FontAttributes="Bold"/>
                    <BoxView HeightRequest="3" Color="#3498DB" HorizontalOptions="Fill"/>
                    <Label Text="Sisteme kayıtlı toplam öğrenci" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Column="1" Grid.Row="0" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Proje Sayısı" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label x:Name="KayitliProjeSayisi" FontSize="28" TextColor="#2C3E50" FontAttributes="Bold"/>
                    <BoxView HeightRequest="3" Color="#2ECC71" HorizontalOptions="Fill"/>
                    <Label Text="Sisteme kayıtlı toplam proje" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Column="2" Grid.Row="0" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Kategori Sayısı" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label x:Name="KayitliKategoriSayisi" FontSize="28" TextColor="#2C3E50" FontAttributes="Bold"/>
                    <BoxView HeightRequest="3" Color="#9B59B6" HorizontalOptions="Fill"/>
                    <Label Text="Sisteme kayıtlı toplam kategori" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Column="0" Grid.Row="1" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Destek Talebi" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label x:Name="KayitliDestekSayisi" FontSize="28" TextColor="#2C3E50" FontAttributes="Bold"/>
                    <BoxView HeightRequest="3" Color="#E74C3C" HorizontalOptions="Fill"/>
                    <Label Text="Bekleyen destek talepleri" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Column="1" Grid.Row="1" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Soru Sayısı" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label x:Name="KayitliSoruSayisi" FontSize="28" TextColor="#2C3E50" FontAttributes="Bold"/>
                    <BoxView HeightRequest="3" Color="#F39C12" HorizontalOptions="Fill"/>
                    <Label Text="Sistemdeki toplam soru" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>

            <Frame Grid.Column="2" Grid.Row="1" BackgroundColor="#FFFFFF" CornerRadius="15" HasShadow="True" Padding="0">
                <StackLayout Spacing="10" Padding="15">
                    <Label Text="Son Aktivite" FontSize="16" TextColor="#7F8C8D" FontAttributes="Bold"/>
                    <Label Text="" FontSize="18" TextColor="#2C3E50"/>
                    <BoxView HeightRequest="3" Color="#1ABC9C" HorizontalOptions="Fill"/>
                    <Label Text="Son güncelleme: 10 dakika önce" FontSize="12" TextColor="#95A5A6"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>