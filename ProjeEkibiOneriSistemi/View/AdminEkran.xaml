<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminEkran"
             Loaded="ContentPage_Loaded">

    <Grid>

        <!-- Arka Plan Görseli -->
        <Image Source="adminekrani.png" HeightRequest="1200"/>

        <!-- Sol Sidebar Arka Planı -->
        <Frame HeightRequest="1000" WidthRequest="200" HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="SeaGreen" Opacity="0.2"/>
        <Frame HeightRequest="1.5" WidthRequest="200" HorizontalOptions="Start" VerticalOptions="Start" Margin="0,200" BackgroundColor="Wheat" BorderColor="Wheat"/>

        <!-- Köşe Yıldızları -->
        <Label Text="*" Margin="10,20" TextColor="Wheat"/>
        <Label Text="*" Margin="10,170" TextColor="Wheat"/>
        <Label Text="*" Margin="170,20" TextColor="Wheat"/>
        <Label Text="*" Margin="170,170" TextColor="Wheat"/>

        <!-- Menü Butonları -->
        <Button Margin="20,220" WidthRequest="160" Text="Öğrenciler" FontAttributes="Bold" BackgroundColor="AntiqueWhite"
                HorizontalOptions="Start" VerticalOptions="Start" Clicked="Button_Clicked"/>

        <Button Margin="20,280" WidthRequest="160" Text="Projeler" FontAttributes="Bold" BackgroundColor="AntiqueWhite"
                HorizontalOptions="Start" VerticalOptions="Start" Clicked="Button_Clicked_1"/>

        <Button Margin="20,340" WidthRequest="160" Text="Testler" FontAttributes="Bold" BackgroundColor="AntiqueWhite"
                HorizontalOptions="Start" VerticalOptions="Start" Clicked="Button_Clicked_2"/>

        <Button Margin="20,290" WidthRequest="160" Text="Destek" FontAttributes="Bold" BackgroundColor="AntiqueWhite"
                HorizontalOptions="Start" VerticalOptions="End"/>

        <Button x:Name="Cikis" Margin="20,40" WidthRequest="160" Text="Çıkış Yap" FontAttributes="Bold" BackgroundColor="AntiqueWhite"
                HorizontalOptions="Start" VerticalOptions="End" Clicked="Cikis_Clicked"/>

        <!-- Sidebar Görsel Çerçeveler (Boş Frame'ler) -->
        <Frame VerticalOptions="Start" HorizontalOptions="Start" WidthRequest="200" Margin="0"/>
        <Frame VerticalOptions="Start" HorizontalOptions="Start" WidthRequest="200" Margin="0,200"/>
        <Frame VerticalOptions="End" HorizontalOptions="Start" WidthRequest="200" Margin="0,260"/>

        <!-- Kullanıcı Bölüm ve Başlık -->
        <Label Text="{Binding Bolum}" Margin="20,230" FontAttributes="Italic" TextColor="Yellow"
               VerticalOptions="End" HorizontalOptions="Start"/>
        <Label Text="Admin Ekranı" Margin="52,205" FontAttributes="Italic"
               VerticalOptions="End" HorizontalOptions="Start"/>

        <!-- Profil Resmi -->
        <Frame Padding="0" BorderColor="LightGray" CornerRadius="150" BackgroundColor="Transparent"
               HeightRequest="150" WidthRequest="150"
               VerticalOptions="Start" HorizontalOptions="Start" Margin="20">
            <Image Aspect="AspectFill" Source="{Binding ogrenciResmi}" HeightRequest="150" WidthRequest="150"
                   BackgroundColor="LightGray" Clip="True">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Image.GestureRecognizers>
            </Image>
        </Frame>

        <!-- İstatistik Kartları -->
        <Frame VerticalOptions="Start" HorizontalOptions="Start" WidthRequest="250" HeightRequest="250" Margin="500,50" BackgroundColor="#0F3D3E"/>
        <Frame VerticalOptions="Start" HorizontalOptions="End" WidthRequest="250" HeightRequest="250" Margin="500,50" BackgroundColor="#28C7C7"/>
        <Frame VerticalOptions="End" HorizontalOptions="End" WidthRequest="250" HeightRequest="250" Margin="500,100" BackgroundColor="#E0E0E0"/>
        <Frame VerticalOptions="End" HorizontalOptions="Start" WidthRequest="250" HeightRequest="250" Margin="500,100" BackgroundColor="#C6FF00"/>
        <Frame VerticalOptions="Start" HorizontalOptions="End" WidthRequest="250" HeightRequest="250" Margin="220,50" BackgroundColor="#C6FF00"/>

        <!-- Sayı Etiketleri ve Başlıklar -->
        <Label Text="Sisteme Kayıtlı Öğrenci Sayısı" Margin="525,60" FontAttributes="Italic"
               VerticalOptions="Start" HorizontalOptions="Start"/>
        <Label x:Name="KayitliOgrenciSayisi" Margin="525,100" TextColor="Black" Text=""
               VerticalOptions="Start" HorizontalOptions="Start"/>

        <Label Text="Sisteme Kayıtlı Proje Sayısı" Margin="540,60" FontAttributes="Italic"
               VerticalOptions="Start" HorizontalOptions="End"/>
        <Label x:Name="KayitliProjeSayisi" Margin="525,100" TextColor="Black" Text=""
               VerticalOptions="Start" HorizontalOptions="End"/>

        <Label Text="Sisteme Kayıtlı Destek Sayısı" Margin="525,320" FontAttributes="Italic" TextColor="DarkGreen"
               VerticalOptions="End" HorizontalOptions="Start"/>
        <Label x:Name="KayitliDestekSayisi" Margin="525,280" TextColor="Black" Text=""
               VerticalOptions="End" HorizontalOptions="Start"/>

        <Label Text="Sisteme Kayıtlı Soru Sayısı" Margin="539,320" FontAttributes="Italic" TextColor="DarkBlue"
               VerticalOptions="End" HorizontalOptions="End"/>
        <Label x:Name="KayitliSoruSayisi" Margin="525,280" TextColor="Black" Text=""
               VerticalOptions="End" HorizontalOptions="End"/>

        <Label Text="Sisteme Kayıtlı Kategori Sayısı" Margin="250,60" FontAttributes="Italic" TextColor="DarkBlue"
               VerticalOptions="Start" HorizontalOptions="End"/>
        <Label x:Name="KayitliKategoriSayisi" Margin="250,100" TextColor="Black" Text=""
               VerticalOptions="Start" HorizontalOptions="End"/>

    </Grid>
</ContentPage>
