<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminOgrenciEkrani"
             BackgroundColor="#181818"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="Auto,*,Auto" Padding="10">

        
        <Image Source="adminekrani.png"
               Aspect="AspectFill"
               Opacity="0.15"
               Grid.RowSpan="3"/>

        
        <Frame Grid.Row="0"
               Margin="10,20,10,10"
               Padding="10"
               CornerRadius="25"
               BackgroundColor="#252525"
               HasShadow="True">
            <SearchBar x:Name="SearchBarOgrenci"
                       Placeholder="Öğrenci ara..."
                       BackgroundColor="#333333"
                       TextColor="White"
                       PlaceholderColor="#BBBBBB"
                       CancelButtonColor="#FF5252"
                       FontSize="16"
                       HeightRequest="50"
                       TextChanged="SearchBarOgrenci_TextChanged"/>
        </Frame>

        
        <ScrollView Grid.Row="1" Padding="5">
            <CollectionView x:Name="CollectionViewOgrenci"
                            SelectionMode="Single"
                            SelectionChanged="CollectionViewOgrenci_SelectionChanged"
                            BackgroundColor="Transparent">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#26A69A"
                               CornerRadius="20"
                               Padding="20"
                               Margin="5"
                               BackgroundColor="#222222"
                               HasShadow="True"
                               WidthRequest="300"
                               MinimumHeightRequest="240">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*"
                                  RowSpacing="10"
                                  ColumnSpacing="10">
                                
                                <Image Source="{Binding ogrenciResmi, FallbackValue='default_profile.png'}"
                                       HeightRequest="80"
                                       WidthRequest="80"
                                       Aspect="AspectFill"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="0,10,0,10">
                                    <Image.Clip>
                                        <EllipseGeometry RadiusX="40" RadiusY="40" Center="40,40"/>
                                    </Image.Clip>
                                    <Image.Shadow>
                                        <Shadow Brush="#000000" Opacity="0.2" Radius="5" Offset="2,2"/>
                                    </Image.Shadow>
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TapImageCommand}"/>
                                    </Image.GestureRecognizers>
                                </Image>

                                
                                <Label Text="Ad:" TextColor="#26A69A" FontSize="14" Grid.Row="1" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding Ad}" TextColor="White" FontSize="14" Grid.Row="1" Grid.Column="1" VerticalOptions="Center"/>

                                <Label Text="Soyad:" TextColor="#26A69A" FontSize="14" Grid.Row="2" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding Soyad}" TextColor="White" FontSize="14" Grid.Row="2" Grid.Column="1" VerticalOptions="Center"/>

                                <Label Text="Öğrenci No:" TextColor="#26A69A" FontSize="14" Grid.Row="3" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding ogrenciNo}" TextColor="White" FontSize="14" Grid.Row="3" Grid.Column="1" VerticalOptions="Center"/>

                                <Label Text="Bölüm:" TextColor="#26A69A" FontSize="14" Grid.Row="4" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding Bolum}" TextColor="White" FontSize="14" Grid.Row="4" Grid.Column="1" VerticalOptions="Center"/>

                                <Label Text="Telefon:" TextColor="#26A69A" FontSize="14" Grid.Row="5" Grid.Column="0" FontAttributes="Bold" VerticalOptions="Center"/>
                                <Label Text="{Binding Telefon}" TextColor="White" FontSize="14" Grid.Row="5" Grid.Column="1" VerticalOptions="Center"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        
        <Frame Grid.Row="2"
               CornerRadius="25"
               Margin="10"
               Padding="15"
               BackgroundColor="#252525"
               HasShadow="True">
            <StackLayout Spacing="15">
                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Center"
                             Spacing="15">
                    <Button Text="Ana Menü"
                            WidthRequest="160"
                            HeightRequest="50"
                            BackgroundColor="#4CAF50"
                            TextColor="White"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="15"
                            Clicked="Button_Clicked">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Opacity="0.3" Radius="10" Offset="2,2"/>
                        </Button.Shadow>
                    </Button>
                    <Button Text="Öğrenci Ekle"
                            WidthRequest="160"
                            HeightRequest="50"
                            BackgroundColor="#FFD600"
                            TextColor="Black"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="15"
                            Clicked="Button_Clicked_1">
                        <Button.Shadow>
                            <Shadow Brush="#000000" Opacity="0.3" Radius="10" Offset="2,2"/>
                        </Button.Shadow>
                    </Button>
                </StackLayout>
                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Start"
                             Spacing="10">
                    <Label Text="Kayıtlı Öğrenci Sayısı:"
                           TextColor="White"
                           FontSize="14"
                           VerticalOptions="Center"/>
                    <Label x:Name="ogrenciSayisi"
                           Text=""
                           TextColor="#FFD600"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                </StackLayout>
            </StackLayout>
        </Frame>
    </Grid>
</ContentPage>