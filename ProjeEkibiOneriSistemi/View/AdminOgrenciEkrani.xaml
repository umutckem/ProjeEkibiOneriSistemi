<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjeEkibiOneriSistemi.View.AdminOgrenciEkrani"
             BackgroundColor="#121212"
             Loaded="ContentPage_Loaded">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Arka Plan Görseli -->
        <Image Source="adminekrani.png"
               Aspect="AspectFill"
               Opacity="0.2"
               IsVisible="True"
               Grid.RowSpan="3"/>

        <!-- Üst Arama Alanı -->
        <Frame Grid.Row="0"
               Margin="10"
               Padding="0"
               CornerRadius="20"
               HasShadow="True"
               BackgroundColor="#1E1E1E">
            <StackLayout Padding="20">
                <SearchBar x:Name="SearchBarOgrenci" 
                           Placeholder="Öğrenci ara..." 
                           BackgroundColor="#2C2C2C" 
                           TextColor="White"
                           PlaceholderColor="DarkGray"
                           CancelButtonColor="Gray"
                           FontAttributes="Bold"
                           TextChanged="SearchBarOgrenci_TextChanged"/>
            </StackLayout>
        </Frame>

        <!-- Öğrenci Listesi -->
        <ScrollView Grid.Row="1" Padding="10">
            <CollectionView x:Name="CollectionViewOgrenci" 
                            SelectionMode="Single" 
                            SelectionChanged="CollectionViewOgrenci_SelectionChanged"
                            BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="#03DAC6" CornerRadius="15" Padding="15" Margin="10" BackgroundColor="#1E1E1E">
                            <Grid ColumnDefinitions="Auto, *"
                                  RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                                  RowSpacing="10" ColumnSpacing="10">

                                <Label Text="Ad:" TextColor="#03DAC6" FontFamily="Cambria" FontSize="16" Grid.Row="0" Grid.Column="0"/>
                                <Label Text="{Binding Ad}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="0" Grid.Column="1"/>

                                <Label Text="Soyad:" TextColor="#03DAC6" FontFamily="Cambria" FontSize="16" Grid.Row="1" Grid.Column="0"/>
                                <Label Text="{Binding Soyad}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="1" Grid.Column="1"/>

                                <Label Text="Öğrenci No:" TextColor="#03DAC6" FontFamily="Cambria" FontSize="16" Grid.Row="2" Grid.Column="0"/>
                                <Label Text="{Binding ogrenciNo}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="2" Grid.Column="1"/>

                                <Label Text="Bölüm:" TextColor="#03DAC6" FontFamily="Cambria" FontSize="16" Grid.Row="3" Grid.Column="0"/>
                                <Label Text="{Binding Bolum}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="3" Grid.Column="1"/>

                                <Label Text="Telefon:" TextColor="#03DAC6" FontFamily="Cambria" FontSize="16" Grid.Row="4" Grid.Column="0"/>
                                <Label Text="{Binding Telefon}" TextColor="White" FontFamily="Cambria" FontSize="16" Grid.Row="4" Grid.Column="1"/>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <!-- Alt Menü -->
        <Frame Grid.Row="2"
               CornerRadius="20"
               Margin="10"
               BackgroundColor="#1E1E1E"
               Padding="10">
            <StackLayout Spacing="10">

                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Center"
                             Spacing="20">
                    <Button Text="Ana Menü"
                            WidthRequest="150"
                            BackgroundColor="#388E3C"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Clicked="Button_Clicked"/>

                    <Button Text="Öğrenci Ekle"
                            WidthRequest="150"
                            BackgroundColor="#FFEB3B"
                            TextColor="Black"
                            FontAttributes="Bold"
                            CornerRadius="10"
                            Clicked="Button_Clicked_1"/>
                </StackLayout>

                <StackLayout Orientation="Horizontal"
                             HorizontalOptions="Start"
                             Padding="10,0,0,0">
                    <Label Text="Kayıtlı Öğrenci Sayısı:" TextColor="White"/>
                    <Label x:Name="ogrenciSayisi" Text="" TextColor="#FF9800" Margin="10,0,0,0"/>
                </StackLayout>

            </StackLayout>
        </Frame>

    </Grid>
</ContentPage>
